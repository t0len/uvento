generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  STUDENT
  ORGANIZER
  ADMIN
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum ParticipationType {
  OPEN
  FREE
  PAID
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  CHECKED_IN
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum OrganizationBlockAction {
  BLOCK
  UNBLOCK
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  lastName      String    @default("")
  phone         String?
  role          UserRole  @default(STUDENT)
  blocked       Boolean   @default(false)
  avatarUrl     String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  organizationMemberships OrganizationMember[]
  registrations           Registration[]
  payments                Payment[]
  blacklists              OrganizationBlacklist[]      @relation("BlacklistSubject")
  blacklistActions        OrganizationBlacklistEntry[] @relation("BlacklistActor")

  @@map("users")
}

model Organization {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?
  logoUrl      String?
  contactEmail String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members    OrganizationMember[]
  events     Event[]
  blacklists OrganizationBlacklist[]

  @@map("organizations")
}

model OrganizationMember {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           String       @default("member")
  joinedAt       DateTime     @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("organization_members")
}

model Event {
  id               String      @id @default(cuid())
  title            String
  slug             String      @unique
  description       String            @default("")
  shortDescription  String?
  coverImageUrl     String?
  location          String            @default("")
  venue             String?
  startDate         DateTime?
  endDate           DateTime?
  capacity          Int?
  price             Int               @default(0)
  participationType ParticipationType @default(FREE)
  status            EventStatus       @default(DRAFT)
  organizationId   String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  registrations Registration[]
  categories    EventCategory[]

  @@index([status, startDate])
  @@index([organizationId])
  @@map("events")
}

model Category {
  id     String          @id @default(cuid())
  name   String          @unique
  slug   String          @unique
  events EventCategory[]

  @@map("categories")
}

model EventCategory {
  eventId    String
  categoryId String

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([eventId, categoryId])
  @@map("event_categories")
}

model Registration {
  id          String             @id @default(cuid())
  userId      String
  eventId     String
  status      RegistrationStatus @default(PENDING)
  quantity    Int                @default(1)
  ticketCode    String             @unique @default(cuid())
  checkedInAt   DateTime?
  reservedUntil DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  payments Payment[]
  tickets Ticket[]

  @@unique([userId, eventId])
  @@index([eventId, status])
  @@map("registrations")
}

model Ticket {
  id             String    @id @default(cuid())
  registrationId String
  code           String    @unique @default(cuid())
  position       Int
  holderName     String    @default("")
  holderLastName String    @default("")
  holderPhone    String    @default("")
  checkedInAt    DateTime?

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([registrationId, position])
  @@index([code])
  @@map("tickets")
}

model Payment {
  id             String        @id @default(cuid())
  registrationId String
  userId         String
  amount         Int
  quantity       Int           @default(1)
  status         PaymentStatus @default(PENDING)
  method         String?
  externalId     String?
  paidAt         DateTime?
  reservedUntil  DateTime?
  holders        Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([registrationId])
  @@index([status])
  @@map("payments")
}

model OrganizationBlacklist {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User                         @relation("BlacklistSubject", fields: [userId], references: [id], onDelete: Cascade)
  entries      OrganizationBlacklistEntry[]

  @@unique([organizationId, userId])
  @@index([organizationId, active])
  @@map("organization_blacklists")
}

model OrganizationBlacklistEntry {
  id           String                  @id @default(cuid())
  blacklistId  String
  action       OrganizationBlockAction
  reason       String
  documentPath String?
  documentName String?
  actorId      String?
  createdAt    DateTime                @default(now())

  blacklist OrganizationBlacklist @relation(fields: [blacklistId], references: [id], onDelete: Cascade)
  actor     User?                 @relation("BlacklistActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([blacklistId, createdAt])
  @@map("organization_blacklist_entries")
}
